# ==============================================================================
# DMart Express Voice-AI Telephony System - Environment Configuration Template
# Copy this file to .env and configure the parameters as needed.
# ==============================================================================

# Store Details & Order Configuration
STORE_NAME="D mart Express"
STORE_PHONE="+17744930623"
MINIMUM_ORDER_VALUE=250.0
DELIVERY_FEE=30.0
FREE_DELIVERY_THRESHOLD=800.0

# Local AI Engine (Ollama)
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="gemma3:latest"
LANGUAGE="kn"

# Local Speech-to-Text (Faster-Whisper)
STT_MODEL_SIZE="base"
STT_LANGUAGE="kn"

# Telephony Server Host & Port
SERVER_HOST="0.0.0.0"
PORT=8765

# (Optional) Cloud-Native Gemini 2.5 Flash Multimodal Live Engine
# If provided, the server switches to Gemini Live sub-500ms speech-to-speech mode.
# Leave blank to use 100% local models (Ollama + Whisper + Piper).
GEMINI_API_KEY=""

# (Optional) Twilio API Credentials for Automated Webhook Configuration Script
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
